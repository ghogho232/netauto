// ---------------------------------------------------------------------
// 핵심 변경 사항:
// - 패널 3, 9, 10은 Prometheus의 Recording Rule을 사용하도록 경량화됨
// - 데이터소스 UID는 prometheus로 고정
// - Threshold 및 Value Mapping을 주석으로 설명
// ---------------------------------------------------------------------
{
  // 대시보드
  "id": null,                                      // Grafana 내부 DB용 ID (파일 프로비저닝 시 null 유지)
  "uid": "prometheus",                             // 대시보드 UID(고유 식별자) 데이터소스 UID와 같아도 무방
  "title": "Netauto — Health & Observability",     // 대시보드 제목
  "tags": [ "netauto" ],                           // 태그(검색/정리용)
  "timezone": "",                                  // 빈 값이면 Grafana 전역 설정/브라우저 타임존 따름
  "schemaVersion": 39,                             // 대시보드 스키마 버전
  "version": 1,                                    // 대시보드 리비전(수정 시 증가)
  "refresh": "10s",                                // 자동 새로고침 주기

  "panels": [
    // 섹션: 요약(Row Panel)
    {
      "type": "row",                                // Row: 시각적 구분선/섹션 헤더
      "title": "Health Summary",                    // 섹션 제목
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } // 대시보드 내 위치/크기
    },

    // 패널 #1: Overall Status
    {
      "type": "stat",                               // Stat: 단일 값 표시
      "title": "Overall Status",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" }, // Prometheus 데이터소스
      "options": {
        "reduceOptions": { "calcs": [ "lastNotNull" ] }, // 최신 유효 값 사용
        "orientation": "auto",                    // 텍스트/값 배치 자동
        "textMode": "auto",
        "colorMode": "value"                      // 값 기반 색상
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" }, // Value 필드에만 스타일 적용
            "properties": [
              {
                "id": "mappings",               // 값, 라벨 매핑
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "degraded" },  // 0 -> degraded
                      "1": { "text": "ok" }         // 1 -> ok
                    }
                  }
                ]
              },
              {
                "id": "thresholds",             // 임계값 색
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red" },         // 기본 빨강
                    { "color": "green", "value": 1 } // 값이 1 이상이면 초록
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        { "expr": "netauto_status", "refId": "A" }  // 0/1 (FastAPI /metrics -> Prometheus)
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 } // 위치/크기
    },

    // 패널 #2: Config Drift
    {
      "type": "stat",
      "title": "Config Drift",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": [ "lastNotNull" ] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "clean" },  // 0 -> clean
                      "1": { "text": "drift" }   // 1 -> drift
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green" },       // clean: 초록
                    { "color": "red", "value": 1 } // drift: 빨강
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        { "expr": "netauto_drift_config", "refId": "A" } // 0/1
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 }
    },

    // 패널 #3: Neighbors Full Ratio — Recording Rule 사용
    {
      "type": "stat",
      "title": "Neighbors Full Ratio",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": [ "lastNotNull" ] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2 }, // 퍼센트 표시
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red" },                // < 0.99 빨강
                    { "color": "yellow", "value": 0.99 }, // 0.99~1 노랑
                    { "color": "green", "value": 1 }   // == 1 초록
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        { "expr": "netauto_neighbors_ratio", "refId": "A" } // sum(full)/sum(total) 레코딩 룰
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 }
    },

    // 패널 #4: Routes (Total) 
    {
      "type": "stat",
      "title": "Routes (Total)",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": [ "lastNotNull" ] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        { "expr": "netauto_routes_total", "refId": "A" } // 총 라우트 수
      ],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 }
    },

    // 섹션: Time Series(Row)
    {
      "type": "row",
      "title": "Time Series",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },

    // 패널 #5: Overall Status (timeline) (Time series)
    {
      "type": "timeseries",
      "title": "Overall Status (timeline)",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1 } }, // 0~1 범위
      "targets": [
        { "expr": "netauto_status", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },

    // 패널 #6: Neighbors: Full vs Total (Time series)
    {
      "type": "timeseries",
      "title": "Neighbors: Full vs Total",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "netauto_neighbors{state=\"full\"}",  "refId": "A", "legendFormat": "full"  }, // FULL
        { "expr": "netauto_neighbors{state=\"total\"}", "refId": "B", "legendFormat": "total" }  // TOTAL
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },

    // 패널 #7: Routes Total (trend) (Time series)
    {
      "type": "timeseries",
      "title": "Routes Total (trend)",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "netauto_routes_total", "refId": "A" } // 추세 확인용
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },

    // 패널 #8: Tests: Passed / Failed / Total (Time series)
    {
      "type": "timeseries",
      "title": "Tests: Passed / Failed / Total",
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "netauto_tests_count{type=\"passed\"}", "refId": "A", "legendFormat": "passed" },
        { "expr": "netauto_tests_count{type=\"failed\"}", "refId": "B", "legendFormat": "failed" },
        { "expr": "netauto_tests_count{type=\"total\"}",  "refId": "C", "legendFormat": "total"  }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },

    // 섹션: Quality Ratios(Row)
    {
      "type": "row",
      "title": "Quality Ratios",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },

    // 패널 #9: Tests Pass Ratio (Gauge) — Recording Rule 사용
    {
      "type": "gauge",
      "title": "Tests Pass Ratio",
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0    }, // <0.95 빨강
              { "color": "yellow", "value": 0.95 }, // 0.95~0.99 노랑
              { "color": "green",  "value": 0.99 }  // ≥0.99 초록
            ]
          }
        }
      },
      "targets": [
        { "expr": "netauto_tests_pass_ratio", "refId": "A" } // passed/total 레코딩 룰
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 }
    },

    // 패널 #10: Neighbors Full Ratio (5m avg) (Gauge) — Recording Rule + 평균
    {
      "type": "gauge",
      "title": "Neighbors Full Ratio (5m avg)",
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0    },
              { "color": "yellow", "value": 0.99 },
              { "color": "green",  "value": 1    }
            ]
          }
        }
      },
      "targets": [
        { "expr": "avg_over_time(netauto_neighbors_ratio[5m:])", "refId": "A" } // 최근 5분 이동 평균
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 }
    },

    // 패널 #11: Firing Alerts (Stat) — 현재 발화 알람 총 개수
    {
      "type": "stat",
      "title": "Firing Alerts",
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": [ "lastNotNull" ] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        { "expr": "sum(ALERTS{alertstate=\"firing\"})", "refId": "A", "instant": true } // firing 상태 알람 개수
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green" },           // 0 -> green
                    { "color": "red", "value": 1 }  // ≥1 -> red
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 33 }
    },

    // 패널 #12: Firing Alerts (live) (Table) — 실시간 알람 상세
    {
      "type": "table",
      "title": "Firing Alerts (live)",
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "showHeader": true },   // 테이블 헤더 표시
      "targets": [
        { "expr": "ALERTS{alertstate=\"firing\"}", "refId": "A", "instant": true } // firing 알람 라벨 포함 원시행
      ],
      "transformations": [
        { "id": "labelsToFields" },        // 라벨들을 개별 컬럼으로 변환
        {
          "id": "organize",
          "options": {
            "indexByName": true,
            "renameByName": { "Value": "value" },  // 값 컬럼 이름 정리
            "excludeByName": { "__name__": true }, // 메트릭 이름 컬럼 숨김
            "order": [                              // 컬럼 표시 순서
              "alertname",
              "severity",
              "instance",
              "job",
              "topo",
              "env",
              "value",
              "runbook_url"
            ]
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "mappings",                     // severity 값 매핑
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": { "text": "critical" },
                      "warning":  { "text": "warning"  }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",                   // 색상: 경고/치명도 시각화
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "yellow" },
                    { "color": "red", "value": 0 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "runbook_url" },
            "properties": [
              {
                "id": "links",                        // 클릭 시 런북 열기
                "value": [
                  { "title": "Open Runbook", "url": "${__value.text}", "targetBlank": true }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "value" },
            "properties": [
              { "id": "unit", "value": "none" },     // 단위 없음
              { "id": "decimals", "value": 0 }       // 정수 표시
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 39 }
    }
  ],

  // 템플릿 변수 영역
  "templating": { "list": [] },                     // 템플릿 변수 사용 안 함

  // 시간 범위 기본값
  "time": { "from": "now-1h", "to": "now" },        // 기본 조회 기간: 최근 1시간

  // 타임피커 설정
  "timepicker": {
    "refresh_intervals": [ "5s", "10s", "30s", "1m", "5m" ] // UI에서 선택 가능한 새로고침 간격
  }
}
